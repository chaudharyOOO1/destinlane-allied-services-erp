# DestinLane Allied Services ERP — backend environment
# Never commit a real .env file or any secret values.

PROJECT_NAME="DestinLane Allied Services ERP"
VERSION="2.0.0"
API_V1_STR="/api/v1"
DEBUG=False

# Required: generate a unique random value for every environment.
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Supabase/PostgreSQL
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-service-role-key

# Administrator synchronization
ADMIN_SETUP_TOKEN=replace-with-a-long-random-one-time-setup-token

# Keep false in production. Local password hashes are only a migration fallback.
ALLOW_LOCAL_PASSWORD_FALLBACK=False

BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
EMPLOYEE_DOCUMENT_BUCKET=employee-documents
